# Un token por agente. Genera cada uno con:  openssl rand -hex 32
AGENT_TOKENS=frontend:PEGA_AQUI_TOKEN_FRONTEND,backend:PEGA_AQUI_TOKEN_BACKEND

# Tailscale / red local: deja 0.0.0.0
# VPS con Caddy (HTTPS): pon 127.0.0.1 para que el puerto 8000 no quede expuesto
BIND_ADDR=0.0.0.0

# Solo para el perfil https (VPS): dominio que apunta a la IP del servidor
DOMAIN=bridge.tudominio.com

# Avisos push con ntfy (https://ntfy.sh): un tema por agente. Cada dev se suscribe SOLO al suyo
# en la app de ntfy (móvil/escritorio) o en https://ntfy.sh/app. Usa nombres largos y aleatorios:
# en ntfy.sh cualquiera que conozca el nombre del tema puede leerlo.
NTFY_TOPICS=frontend:PEGA_AQUI_TEMA_FRONTEND,backend:PEGA_AQUI_TEMA_BACKEND
# NTFY_SERVER=https://ntfy.sh        # o tu propio servidor ntfy
# NTFY_TOKEN=                         # si tu servidor ntfy pide token de acceso
# NTFY_INCLUDE_TEXT=false             # true = el aviso incluye el texto de la pregunta
